# =============================================================================
# Truco Mineiro — variáveis de ambiente
# Copie para `.env` e preencha. O `.env` NÃO vai para o repositório.
# =============================================================================

# Ambiente de anúncios: "staging" ou "production".
# Vazio ou qualquer outro valor = production em build de release; em `__DEV__` é sempre
# development. Development e staging usam SEMPRE os Test Ads oficiais do Google, mesmo que os
# IDs de produção abaixo estejam preenchidos.
EXPO_PUBLIC_APP_ENV=

# -----------------------------------------------------------------------------
# Google Mobile Ads (AdMob) — IDs de PRODUÇÃO
#
# Todos nascem vazios e assim devem permanecer até que o app real seja criado no painel do
# AdMob. Enquanto um ID estiver vazio, o placement correspondente fica DESLIGADO em produção —
# o app publicado nunca cai para Test Ads (isso geraria tráfego inválido).
#
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele a variável não chega ao bundle do app.
# Onde cada ID é usado está documentado em docs/ADMOB_MONETIZATION.md.
# -----------------------------------------------------------------------------

# App ID (vai para o AndroidManifest / Info.plist via app.config.js).
# Vazio = usa o sample app ID oficial do Google, válido apenas para desenvolvimento.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# Interstitial — placement `match_result_interstitial` (tela de resultado da partida).
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_MATCH_RESULT=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_MATCH_RESULT=

# Rewarded — placement `match_analysis_rewarded` (análise completa da partida).
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_MATCH_ANALYSIS=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_MATCH_ANALYSIS=

# Rewarded — placement `home_tip_rewarded` (dica de Truco na Principal).
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_HOME_TIP=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_HOME_TIP=

# Native — placement `home_native_primary` (Principal).
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_HOME=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_HOME=

# Native — placement `league_native_footer` (rodapé da Liga).
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_LEAGUE=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_LEAGUE=

# Native — placement `friends_native_footer` (rodapé de Amigos).
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_FRIENDS=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_FRIENDS=

# Native — placement `profile_native` (Perfil). Preparado, porém desligado por Remote Config
# (`native_profile_enabled = false`).
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE_PROFILE=
EXPO_PUBLIC_ADMOB_IOS_NATIVE_PROFILE=

# App Open — placement `app_open`. Formato desligado no lançamento
# (`app_open_enabled = false`).
EXPO_PUBLIC_ADMOB_ANDROID_APP_OPEN=
EXPO_PUBLIC_ADMOB_IOS_APP_OPEN=

# -----------------------------------------------------------------------------
# QA de anúncios (apenas desenvolvimento)
# -----------------------------------------------------------------------------

# IDs de dispositivo de teste, separados por vírgula. Obtidos no logcat do aparelho quando o
# SDK inicializa ("Use RequestConfiguration.Builder.setTestDeviceIds(...)").
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=

# Força a geografia do formulário de consentimento (UMP) durante o QA.
# Valores: EEA | REGULATED_US_STATE | OTHER. Ignorado em produção.
EXPO_PUBLIC_ADMOB_DEBUG_GEOGRAPHY=

# -----------------------------------------------------------------------------
# Firebase Emulator Suite
# -----------------------------------------------------------------------------
EXPO_PUBLIC_USE_EMULATORS=

# -----------------------------------------------------------------------------
# Backend (NestJS) — REST + WebSocket
# Dev: vazio = http://10.0.2.2:11002 (emulador Android) / http://localhost:11002 (iOS/web).
# Staging/produção: obrigatório e HTTPS (o app.config.js recusa o build sem isso).
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=
# Vazio = mesma origem da API.
EXPO_PUBLIC_WS_URL=
# 1 = aceita http:// fora de dev (apenas QA em rede local; proibido em produção).
EXPO_PUBLIC_ALLOW_INSECURE_API=
