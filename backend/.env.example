# =============================================================================
# Truco Mineiro — backend (NestJS). Copie para `.env` e preencha.
# `.env` e `.env.*` NÃO vão para o repositório. Em staging/produção os valores vêm do
# Secret Manager (Cloud Run) — nunca de arquivo.
# =============================================================================

# development | test | staging | production
NODE_ENV=development
PORT=11002
LOG_LEVEL=info
# Espera antes de fechar sockets no SIGTERM (readiness já responde 503).
SHUTDOWN_DRAIN_MS=3000
# Swagger (/docs) fica desligado em produção; true liga mesmo assim.
SWAGGER_ENABLED=false
# Identificador da instância nos logs/presença (Cloud Run usa K_REVISION automaticamente).
INSTANCE_ID=

# --- Banco (PostgreSQL) -------------------------------------------------------
# Dev local: instância PostgreSQL compartilhada (127.0.0.1:5432), banco próprio do projeto.
# O usuário da aplicação tem limite de conexões: a soma dos `connection_limit` de todas as
# instâncias locais (backend + testes + carga) precisa ficar abaixo dele.
DATABASE_URL="postgresql://<usuario>:<senha>@127.0.0.1:5432/truco_mineiro_db?schema=public&connection_limit=10&pool_timeout=10"
# Só para `prisma migrate dev` (o usuário da aplicação não cria bancos).
SHADOW_DATABASE_URL="postgresql://<usuario>:<senha>@127.0.0.1:5432/truco_mineiro_shadow_db?schema=public"
# Consultas acima disso contam como lentas (métrica + log fora de produção).
SLOW_QUERY_MS=200

# --- Firebase (só Auth por telefone, FCM e App Check) -----------------------------
FIREBASE_PROJECT_ID=truco-mineiro-wjf
# firebase = valida o ID token com o Admin SDK. test = tokens `test:<uid>:<telefone>`
# (proibido em staging/produção — o boot falha).
AUTH_MODE=firebase
# Dev: Auth Emulator (proibido em staging/produção).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Fora do Cloud Run: JSON da service account (no Cloud Run use a identidade do serviço).
FIREBASE_SERVICE_ACCOUNT_JSON=
ENFORCE_APP_CHECK=false
PUSH_ENABLED=true

# --- Segredos (>= 32 caracteres em staging/produção) -------------------------------
# HMAC do diretório de telefones (contatos). Trocar invalida os hashes existentes.
CONTACTS_PEPPER=
# Cabeçalho x-admin-secret de /metrics e /v1/admin/*.
ADMIN_SECRET=
# Assinatura HMAC dos webhooks do agendador (JOBS_MODE=external exige este segredo OU o OIDC abaixo).
WEBHOOK_SCHEDULER_SECRET=
# Alternativa ao HMAC: Cloud Scheduler com token OIDC (as duas variáveis juntas).
WEBHOOK_SCHEDULER_OIDC_AUDIENCE=
WEBHOOK_SCHEDULER_SERVICE_ACCOUNT=

# --- Jobs ------------------------------------------------------------------------
# cron = a própria instância agenda (dev/instância única). external = Cloud Scheduler chama
# POST /webhooks/scheduler. off = nenhum job (testes, carga).
JOBS_MODE=cron
SCHEDULER_POLL_MS=1000

# --- Tempo real / várias instâncias ------------------------------------------------
# Obrigatório com mais de uma instância (adapter Redis do Socket.IO).
REDIS_URL=
# Prazo para conectar ao Redis no boot (ms); depois disso a instância falha.
REDIS_BOOT_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:11003,http://localhost:8082
# Requisições HTTP por minuto por sessão (token) ou IP.
HTTP_RATE_LIMIT=300

# --- Regras de sala/partida (segundos) ----------------------------------------------
PRIVATE_ROOM_WAIT_SECONDS=30
ROOM_INVITE_TTL_SECONDS=600
DISCONNECT_AI_GRACE_SECONDS=8
BOT_FALLBACK_SECONDS=3
# Busca de partida sem renovação expira (app morto); sem socket por N s, a busca é cancelada.
MATCHMAKING_MAX_SEARCH_SECONDS=150
MATCHMAKING_DISCONNECT_GRACE_SECONDS=15
