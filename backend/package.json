{
  "name": "truco-mineiro-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend autoritativo do Truco Mineiro (NestJS + PostgreSQL + Socket.IO)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-domain": "node ./scripts/sync-domain.js",
    "prebuild": "npm run sync-domain",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run sync-domain && ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "npm run sync-domain && tsc --noEmit -p tsconfig.json",
    "test": "npm run sync-domain && jest --selectProjects unit",
    "test:integration": "npm run sync-domain && jest --selectProjects integration --runInBand",
    "test:all": "npm run sync-domain && jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "migrate:firebase": "ts-node --transpile-only scripts/migrate-firebase-to-postgres.ts",
    "load:test": "ts-node --transpile-only scripts/load-test.ts",
    "smoke": "ts-node --transpile-only scripts/smoke-test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "11.1.6",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron": "4.4.0",
    "firebase-admin": "13.10.0",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "redis": "4.7.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "protobufjs@7.6.6": true
  }
}
