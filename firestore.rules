rules_version = '2';
// Firestore DESATIVADO. Toda a persistência do Truco Mineiro está no PostgreSQL (backend NestJS).
// Estas regras só existem para o período de segurança da migração: ninguém lê nem escreve.
// Depois do período de rollback o banco é apagado no Console (docs/production-runbook.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
