rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DENY BY DEFAULT. All writes go through Cloud Functions (Admin SDK bypasses rules).
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /profiles/{uid} { allow read: if signedIn(); allow write: if false; }
    match /playerStats/{uid} { allow read: if signedIn(); allow write: if false; }
    match /userAchievements/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /rewards/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
    match /purchases/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }

    match /matchHistory/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerIds;
      allow write: if false;
    }

    match /leagues/{id} { allow read: if signedIn(); allow write: if false; }
    match /seasons/{id} { allow read: if signedIn(); allow write: if false; }
    match /achievements/{id} { allow read: if signedIn(); allow write: if false; }

    match /friendships/{uid}/friends/{friendUid} { allow read: if isOwner(uid); allow write: if false; }
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
