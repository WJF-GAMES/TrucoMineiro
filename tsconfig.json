{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src",
    "App.tsx",
    "index.ts",
    "scripts",
    "jest.setup.ts",
    "__mocks__",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "backend",
    "android",
    "ios"
  ]
}